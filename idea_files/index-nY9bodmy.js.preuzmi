 */const tc=ve("X",[["path",{d:"M18 6 6 18",key:"1bl5f8"}],["path",{d:"m6 6 12 12",key:"d8bk6v"}]]),kp=JSON.parse(`[{"id":"hn-49548600","title":"MCP Production Use Case Directory","summary":"A crowdsourced registry and evaluation dashboard showcasing real-world production implementations of the Model Context Protocol (MCP).","category":"Developer Tools","difficulty":"Intermediate","technologies":["API","CLI","TypeScript","React"],"source":"Hacker News · Ask HN","datasetTools":"Hacker News public API","whyBuildIt":"Developers adopting new protocols need concrete, working examples of production architectures to justify and guide their integration efforts.","suggestedSteps":["Design a submission schema for developers to share their MCP architecture, server implementation, and scaling strategies.","Build a searchable web directory featuring filters for cloud providers, transport layers, and use-case categories.","Create a CLI utility that validates local MCP configuration files against community best practices."],"color":"green","sourceId":"hacker-news","sourceName":"Hacker News","sourceUrl":"https://news.ycombinator.com/item?id=49548600","license":"Hacker News public API (see usage note)","usageNote":"Story metadata is collected from the public Hacker News API; linked content remains owned by its authors.","attribution":"Hacker News / Y Combinator; linked content remains owned by its authors.","collectedAt":"2026-09-04T21:07:06.899Z","approved":false,"qualityScore":100,"recommendation":"build","decision":"keep","discardReason":"","enrichedBy":"gemini"},{"id":"hn-49551096","title":"Multi-Provider AI Service Status Aggregator","summary":"A real-time dashboard tracking concurrent service outages, latency spikes, and recovery metrics across major AI providers like OpenAI, Anthropic, and xAI.","category":"Monitoring","difficulty":"Starter","technologies":["AI","API","Node.js","WebSockets"],"source":"Hacker News · Ask HN","datasetTools":"Hacker News public API","whyBuildIt":