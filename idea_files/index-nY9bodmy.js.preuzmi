d":"hacker-news","sourceName":"Hacker News","sourceUrl":"https://news.ycombinator.com/item?id=49555592","license":"Hacker News public API (see usage note)","usageNote":"Story metadata is collected from the public Hacker News API; linked content remains owned by its authors.","attribution":"Hacker News / Y Combinator; linked content remains owned by its authors.","collectedAt":"2026-09-04T21:07:06.899Z","approved":false,"qualityScore":100,"recommendation":"build","decision":"keep","discardReason":"","enrichedBy":"gemini"},{"id":"hn-49522897","title":"Remote Tech Hiring Market Analyzer","summary":"An intelligent job board parser and analytics tool that extracts remote work trends, geographic restrictions, and hiring demands from community job threads.","category":"Productivity","difficulty":"Intermediate","technologies":["AI","API","GIS","Python"],"source":"Hacker News · Ask HN","datasetTools":"Hacker News public API","whyBuildIt":"Job seekers benefit immensely from structured geographical and remote policy insights aggregated from monthly hiring discussions.","suggestedSteps":["Build an extraction pipeline to parse comments from monthly hiring threads and classify remote policy constraints.","Integrate geospatial tagging to map company locations against allowed remote work jurisdictions.","Create a searchable interface with advanced filters for tech stack requirements and compensation disclosures."],"color":"green","sourceId":"hacker-news","sourceName":"Hacker News","sourceUrl":"https://news.ycombinator.com/item?id=49522897","license":"Hacker News public API (see usage note)","usageNote":"Story metadata is collected from the public Hacker News API; linked content remains owned by its authors.","attribution":"Hacker News / Y Combinator; linked content remains owned by its authors.","collectedAt":"2026-09-04T21:07:06.899Z","approved":false,"qualityScore":100,"recommendation":"build","decision":"keep","discardReason":"","enrichedBy":"gemini"},{"id":"hn-49568460","title"